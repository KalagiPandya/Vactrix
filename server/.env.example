PORT=5000
# Local development (default): mongodb://localhost:27017/vactrix
# Production (Render): paste your MongoDB Atlas connection string here instead
MONGO_URI=mongodb://localhost:27017/vactrix
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=development
# Set this to your deployed frontend URL in production (e.g. https://vactrix.vercel.app)
CLIENT_URL=
